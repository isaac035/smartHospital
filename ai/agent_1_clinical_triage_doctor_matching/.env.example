# Copy to .env (git-ignored) and fill in real values. Never commit .env.

# LLM provider: gemini (Google Gemini, default) or anthropic (Claude).
AI_PROVIDER=gemini
# API key for that provider. Gemini: https://aistudio.google.com/apikey  (required)
AI_API_KEY=
# Model id. Leave empty for the provider default (gemini-3.8-flash / claude-opus-5-5).
AI_MODEL=
# Gemini only: models tried in order if the main one is overloaded/unavailable (empty = no fallback).
AI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest
# Seconds before an LLM call is abandoned (the API then shows the manual fallback).
AI_TIMEOUT_SECONDS=20
# Anthropic only: re-run on a fallback model if the primary model declines.
AI_ENABLE_FALLBACKS=true

# Shared secret. Must equal Agent1__InternalApiKey configured for the ASP.NET Core API.
# Generate a long random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENT1_INTERNAL_API_KEY=

# Confidence below which triage falls back to the default category (General Medicine).
AGENT1_MIN_CONFIDENCE=0.5
# Max doctors returned per recommendation.
AGENT1_MAX_RECOMMENDATIONS=5
